SUPABASE_URL=https://mfkvwcryiclehbrkqthu.supabase.co

# Recommended on server for full access (KEEP SECRET)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# If you only use anon key on server (limited by RLS)
SUPABASE_ANON_KEY=your-anon-key

# Optional (for email sending)
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SCHOOL_EMAIL=

# Optional: frontend URL to allow in CORS (example: https://your-site.netlify.app)
FRONTEND_URL=

# Optional: storage configuration
SUPABASE_PDF_BUCKET=registrations
SUPABASE_PDF_PREFIX=registrations
SUPABASE_SIGNED_URL_TTL=3600

PORT=5000

# Email (move secrets out of server.js)
SCHOOL_EMAIL=you@example.com
SMTP_SERVICE=gmail
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
# Prefer service role on backend; keep it secret and NEVER expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage buckets/object keys
SUPABASE_PDF_BUCKET=registrations
SUPABASE_PDF_PREFIX=registrations
SUPABASE_SETTINGS_BUCKET=app-settings
SUPABASE_REG_STATUS_KEY=reg_status.json
SUPABASE_PDF_LAYOUTS_KEY=pdf_layouts.json

# Signed URL expiry for admin download links (seconds)
SUPABASE_SIGNED_URL_TTL=3600
